{
  "_metadata": {
    "description": "City-level geographic risk lookup table for V4 champion model enrichment",
    "key_format": "{city_normalised}  (lowercase, underscored, stripped)",
    "fields": {
      "region_risk_category": "str  Low | Medium | High | Very High  (actuarial zone)",
      "flood_risk_index": "float 0.0-1.0  historical flood frequency x severity (NDMA)",
      "theft_risk_index": "float 0.0-1.0  vehicle theft incidence rate (NCRB 2023)",
      "monsoon_exposure_index": "float 0.0-1.0  average monsoon rainfall intensity (IMD)"
    },
    "derived_fields": {
      "pincode_risk_score": "float 0.0-1.0  computed by lookup_loader as 0.35*flood + 0.40*theft + 0.25*monsoon"
    },
    "data_sources": [
      "NCRB India Crime Statistics 2023 - vehicle theft by city",
      "NDMA India Flood Hazard Atlas - city flood risk zones",
      "IMD India Rainfall Data 2023 - city annual average",
      "IRDAI Regional Risk Classification 2024"
    ],
    "national_defaults": {
      "region_risk_category": "Medium",
      "flood_risk_index": 0.30,
      "theft_risk_index": 0.30,
      "monsoon_exposure_index": 0.40
    },
    "version": "1.0.0",
    "created": "2026-06-22",
    "city_count": 52
  },


    "key_structure": "{City: {risk_fields}}",
    "risk_scale": "All risk indices are on a continuous 1-10 scale (1=lowest risk, 10=highest risk). Values are per-city representative means derived from the V4 training dataset.",
    "fields": {
      "region_risk_category": "str  High|Medium  (High = Tier-1 metro, Medium = Tier-2 city)",
      "flood_risk_index": "float 1.0-10.0  (historical flood frequency x severity; NDMA India Flood Hazard Atlas)",
      "theft_risk_index": "float 1.0-10.0  (vehicle theft incidence rate; NCRB 2023)",
      "monsoon_exposure_index": "float 1.0-10.0  (average annual monsoon rainfall intensity; IMD)"
    },
    "category_mapping": {
      "High": "Tier-1 metropolitan cities with elevated urbanisation-driven risk (dataset code: 1)",
      "Medium": "Tier-2 cities with moderate risk profile (dataset code: 2)"
    },
